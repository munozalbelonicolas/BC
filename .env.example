# ===================================================================
# BC ESPECIAL IMPORT - ENVIRONMENT CONFIGURATION
# ===================================================================

# Entorno activo de la aplicación:
# Opciones disponibles: 'development' | 'demo' | 'test' | 'production'
# En 'production': los datos demo están estrictamente prohibidos y bloqueados.
VITE_APP_ENV=development

# Conexión a Supabase (PostgreSQL & Auth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
